U32 STRCMP(PU8 str1, PU8 str2) {
    U32 i = 0;
    while (str1[i] != 0 && str2[i] != 0) {
        if (str1[i] != str2[i]) {
            return 0; // Strings are not equal
        }
        i++;
    }
    return str1[i] == str2[i]; // Return 1 if both strings ended, else 0
}

U32 STRICMP(PU8 str1, PU8 str2) {
    U32 i = 0;
    while (str1[i] != 0 && str2[i] != 0) {
        U8 c1 = str1[i];
        U8 c2 = str2[i];
        // Convert to lowercase if uppercase
        if (c1 >= 'A' && c1 <= 'Z') {
            c1 += 32;
        }
        if (c2 >= 'A' && c2 <= 'Z') {
            c2 += 32;
        }
        if (c1 != c2) {
            return 0; // Strings are not equal
        }
        i++;
    }
    return str1[i] == str2[i]; // Return 1 if both strings ended, else 0
}

U32 STRLEN(PU8 str) {
    U32 len = 0;
    while (str[len] != 0) {
        len++;
    }
    return len;
}

U32 STRNCMP(PU8 str1, PU8 str2, U32 n) {
    U32 i = 0;
    while (i < n && str1[i] != 0 && str2[i] != 0) {
        if (str1[i] != str2[i]) {
            return 0; // Strings are not equal
        }
        i++;
    }
    return i == n || (str1[i] == str2[i]); // Return 1 if both strings ended or reached n, else 0
}

U32 STRNICMP(PU8 str1, PU8 str2, U32 n) {
    U32 i = 0;
    while (i < n && str1[i] != 0 && str2[i] != 0) {
        U8 c1 = str1[i];
        U8 c2 = str2[i];
        // Convert to lowercase if uppercase
        if (c1 >= 'A' && c1 <= 'Z') {
            c1 += 32;
        }
        if (c2 >= 'A' && c2 <= 'Z') {
            c2 += 32;
        }
        if (c1 != c2) {
            return 0; // Strings are not equal
        }
        i++;
    }
    return i == n || (str1[i] == str2[i]); // Return 1 if both strings ended or reached n, else 0
}

U32 STRNLEN(PU8 str, U32 n) {
    U32 len = 0;
    while (len < n && str[len] != 0) {
        len++;
    }
    return len;
}


U32 STRCHR(PU8 str, U8 c) {
    U32 i = 0;
    while (str[i] != 0) {
        if (str[i] == c) {
            return i; // Return index of first occurrence
        }
        i++;
    }
    return -1; // Character not found
}

U32 STRRCHR(PU8 str, U8 c) {
    U32 i = 0;
    U32 last_index = -1;
    while (str[i] != 0) {
        if (str[i] == c) {
            last_index = i; // Update last occurrence index
        }
        i++;
    }
    return last_index; // Return index of last occurrence or -1 if not found
}