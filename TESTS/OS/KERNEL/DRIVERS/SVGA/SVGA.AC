// SVGA.AC — SVGA/VBE framebuffer driver with a simple 8x8 text console.
//
// The second-stage bootloader sets VBE mode 0x13 (320x200x256) and fills a
// _BOOTSTRAP structure with the VBE info block and mode info block.  This
// driver validates that structure, extracts the framebuffer parameters, and
// exposes pixel drawing plus a bitmap-font text console.

// ── Module state ──────────────────────────────────────────────────────
PU8 svga_fb;         // framebuffer base address
U32 svga_width;      // horizontal resolution
U32 svga_height;     // vertical resolution
U32 svga_pitch;      // bytes per scan line
U8  svga_bpp;        // bits per pixel
PU8 svga_font;       // pointer to the 8x8 font (8 bytes per glyph)
U32 svga_cx;         // cursor X (character cell)
U32 svga_cy;         // cursor Y (character cell)
U32 svga_fg;         // foreground color
U32 svga_bg;         // background color

// ── Font data (emitted into the .data section via inline asm) ──────────
// 95 glyphs, ASCII 0x20..0x7E, 8 bytes each (top row first).
U0 svga_font_data_hi()
{
    asm {
        .data
    svga_font8x8:
        DB 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 ; ' '
        DB 0x18,0x18,0x18,0x18,0x18,0x00,0x18,0x00 ; '!'
        DB 0x6C,0x6C,0x6C,0x00,0x00,0x00,0x00,0x00 ; '"'
        DB 0x6C,0x6C,0xFE,0x6C,0xFE,0x6C,0x6C,0x00 ; '#'
        DB 0x18,0x3E,0x60,0x3C,0x06,0x7C,0x18,0x00 ; '$'
        DB 0x00,0xC6,0xCC,0x18,0x30,0x66,0xC6,0x00 ; '%'
        DB 0x38,0x6C,0x38,0x76,0xDC,0xCC,0x76,0x00 ; '&'
        DB 0x18,0x18,0x30,0x00,0x00,0x00,0x00,0x00 ; '''
        DB 0x0C,0x18,0x30,0x30,0x30,0x18,0x0C,0x00 ; '('
        DB 0x30,0x18,0x0C,0x0C,0x0C,0x18,0x30,0x00 ; ')'
        DB 0x00,0x66,0x3C,0xFF,0x3C,0x66,0x00,0x00 ; '*'
        DB 0x00,0x18,0x18,0x7E,0x18,0x18,0x00,0x00 ; '+'
        DB 0x00,0x00,0x00,0x00,0x00,0x18,0x18,0x30 ; ','
        DB 0x00,0x00,0x00,0x7E,0x00,0x00,0x00,0x00 ; '-'
        DB 0x00,0x00,0x00,0x00,0x00,0x18,0x18,0x00 ; '.'
        DB 0x06,0x0C,0x18,0x30,0x60,0xC0,0x80,0x00 ; '/'
        DB 0x3C,0x66,0x6E,0x76,0x66,0x66,0x3C,0x00 ; '0'
        DB 0x18,0x38,0x18,0x18,0x18,0x18,0x7E,0x00 ; '1'
        DB 0x3C,0x66,0x06,0x0C,0x18,0x30,0x7E,0x00 ; '2'
        DB 0x3C,0x66,0x06,0x1C,0x06,0x66,0x3C,0x00 ; '3'
        DB 0x0C,0x1C,0x3C,0x6C,0x7E,0x0C,0x0C,0x00 ; '4'
        DB 0x7E,0x60,0x7C,0x06,0x06,0x66,0x3C,0x00 ; '5'
        DB 0x1C,0x30,0x60,0x7C,0x66,0x66,0x3C,0x00 ; '6'
        DB 0x7E,0x06,0x0C,0x18,0x30,0x30,0x30,0x00 ; '7'
        DB 0x3C,0x66,0x66,0x3C,0x66,0x66,0x3C,0x00 ; '8'
        DB 0x3C,0x66,0x66,0x3E,0x06,0x0C,0x38,0x00 ; '9'
        DB 0x00,0x18,0x18,0x00,0x00,0x18,0x18,0x00 ; ':'
        DB 0x00,0x18,0x18,0x00,0x00,0x18,0x18,0x30 ; ';'
        DB 0x0C,0x18,0x30,0x60,0x30,0x18,0x0C,0x00 ; '<'
        DB 0x00,0x00,0x7E,0x00,0x7E,0x00,0x00,0x00 ; '='
        DB 0x30,0x18,0x0C,0x06,0x0C,0x18,0x30,0x00 ; '>'
        DB 0x3C,0x66,0x06,0x0C,0x18,0x00,0x18,0x00 ; '?'
        DB 0x3C,0x66,0x6E,0x6A,0x6E,0x60,0x3C,0x00 ; '@'
        DB 0x18,0x3C,0x66,0x66,0x7E,0x66,0x66,0x00 ; 'A'
        DB 0x7C,0x66,0x66,0x7C,0x66,0x66,0x7C,0x00 ; 'B'
        DB 0x3C,0x66,0x60,0x60,0x60,0x66,0x3C,0x00 ; 'C'
        DB 0x78,0x6C,0x66,0x66,0x66,0x6C,0x78,0x00 ; 'D'
        DB 0x7E,0x60,0x60,0x78,0x60,0x60,0x7E,0x00 ; 'E'
        DB 0x7E,0x60,0x60,0x78,0x60,0x60,0x60,0x00 ; 'F'
        DB 0x3C,0x66,0x60,0x6E,0x66,0x66,0x3C,0x00 ; 'G'
        DB 0x66,0x66,0x66,0x7E,0x66,0x66,0x66,0x00 ; 'H'
        DB 0x7E,0x18,0x18,0x18,0x18,0x18,0x7E,0x00 ; 'I'
        DB 0x06,0x06,0x06,0x06,0x66,0x66,0x3C,0x00 ; 'J'
        DB 0x66,0x6C,0x78,0x70,0x78,0x6C,0x66,0x00 ; 'K'
        DB 0x60,0x60,0x60,0x60,0x60,0x60,0x7E,0x00 ; 'L'
        DB 0xC6,0xEE,0xFE,0xFE,0xD6,0xC6,0xC6,0x00 ; 'M'
        DB 0x66,0x76,0x7E,0x7E,0x6E,0x66,0x66,0x00 ; 'N'
        DB 0x3C,0x66,0x66,0x66,0x66,0x66,0x3C,0x00 ; 'O'
        DB 0x7C,0x66,0x66,0x7C,0x60,0x60,0x60,0x00 ; 'P'
        DB 0x3C,0x66,0x66,0x66,0x6C,0x66,0x3A,0x00 ; 'Q'
        DB 0x7C,0x66,0x66,0x7C,0x78,0x6C,0x66,0x00 ; 'R'
        DB 0x3C,0x66,0x60,0x3C,0x06,0x66,0x3C,0x00 ; 'S'
        DB 0x7E,0x18,0x18,0x18,0x18,0x18,0x18,0x00 ; 'T'
        DB 0x66,0x66,0x66,0x66,0x66,0x66,0x3C,0x00 ; 'U'
        DB 0x66,0x66,0x66,0x66,0x66,0x3C,0x18,0x00 ; 'V'
        DB 0xC6,0xC6,0xC6,0xD6,0xFE,0xEE,0xC6,0x00 ; 'W'
        DB 0x66,0x66,0x3C,0x18,0x3C,0x66,0x66,0x00 ; 'X'
        DB 0x66,0x66,0x3C,0x18,0x18,0x18,0x18,0x00 ; 'Y'
        DB 0x7E,0x06,0x0C,0x18,0x30,0x60,0x7E,0x00 ; 'Z'
        DB 0x3C,0x30,0x30,0x30,0x30,0x30,0x3C,0x00 ; '['
        DB 0xC0,0x60,0x30,0x18,0x0C,0x06,0x02,0x00 ; '\'
        DB 0x3C,0x0C,0x0C,0x0C,0x0C,0x0C,0x3C,0x00 ; ']'
        DB 0x18,0x3C,0x66,0x00,0x00,0x00,0x00,0x00 ; '^'
        DB 0x00,0x00,0x00,0x00,0x00,0x00,0xFF,0x00 ; '_'
        .code
    }
}

U0 svga_font_data_lo()
{
    asm {
        .data
        DB 0x30,0x18,0x0C,0x00,0x00,0x00,0x00,0x00 ; '`'
        DB 0x00,0x00,0x3C,0x06,0x3E,0x66,0x3E,0x00 ; 'a'
        DB 0x60,0x60,0x7C,0x66,0x66,0x66,0x7C,0x00 ; 'b'
        DB 0x00,0x00,0x3C,0x66,0x60,0x66,0x3C,0x00 ; 'c'
        DB 0x06,0x06,0x3E,0x66,0x66,0x66,0x3E,0x00 ; 'd'
        DB 0x00,0x00,0x3C,0x66,0x7E,0x60,0x3C,0x00 ; 'e'
        DB 0x1C,0x30,0x7C,0x30,0x30,0x30,0x30,0x00 ; 'f'
        DB 0x00,0x00,0x3E,0x66,0x66,0x3E,0x06,0x3C ; 'g'
        DB 0x60,0x60,0x7C,0x66,0x66,0x66,0x66,0x00 ; 'h'
        DB 0x18,0x00,0x38,0x18,0x18,0x18,0x3C,0x00 ; 'i'
        DB 0x0C,0x00,0x0C,0x0C,0x0C,0x0C,0x0C,0x38 ; 'j'
        DB 0x60,0x60,0x66,0x6C,0x78,0x6C,0x66,0x00 ; 'k'
        DB 0x38,0x18,0x18,0x18,0x18,0x18,0x3C,0x00 ; 'l'
        DB 0x00,0x00,0xCC,0xFE,0xFE,0xD6,0xC6,0x00 ; 'm'
        DB 0x00,0x00,0x7C,0x66,0x66,0x66,0x66,0x00 ; 'n'
        DB 0x00,0x00,0x3C,0x66,0x66,0x66,0x3C,0x00 ; 'o'
        DB 0x00,0x00,0x7C,0x66,0x66,0x7C,0x60,0x60 ; 'p'
        DB 0x00,0x00,0x3E,0x66,0x66,0x3E,0x06,0x06 ; 'q'
        DB 0x00,0x00,0x7C,0x66,0x60,0x60,0x60,0x00 ; 'r'
        DB 0x00,0x00,0x3E,0x60,0x3C,0x06,0x7C,0x00 ; 's'
        DB 0x30,0x30,0x7C,0x30,0x30,0x30,0x1C,0x00 ; 't'
        DB 0x00,0x00,0x66,0x66,0x66,0x66,0x3E,0x00 ; 'u'
        DB 0x00,0x00,0x66,0x66,0x66,0x3C,0x18,0x00 ; 'v'
        DB 0x00,0x00,0xC6,0xD6,0xFE,0xFE,0x6C,0x00 ; 'w'
        DB 0x00,0x00,0x66,0x3C,0x18,0x3C,0x66,0x00 ; 'x'
        DB 0x00,0x00,0x66,0x66,0x3E,0x06,0x3C,0x00 ; 'y'
        DB 0x00,0x00,0x7E,0x0C,0x18,0x30,0x7E,0x00 ; 'z'
        DB 0x0E,0x18,0x18,0x70,0x18,0x18,0x0E,0x00 ; '{'
        DB 0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x00 ; '|'
        DB 0x70,0x18,0x18,0x0E,0x18,0x18,0x70,0x00 ; '}'
        DB 0x00,0x00,0x76,0xDC,0x00,0x00,0x00,0x00 ; '~'
        .code
    }
}

// Write one pixel using the current bit depth.
U0 svga_set_px(U32 x, U32 y, U32 px)
{
    if (!svga_fb) return;
    if (x >= svga_width || y >= svga_height) return;
    if (svga_bpp == 8) {
        svga_fb[y * svga_pitch + x] = (U8)px;
    } else if (svga_bpp == 16) {
        PU16 p16 = (PU16)(svga_fb + y * svga_pitch + x * 2);
        p16[0] = (U16)px;
    } else if (svga_bpp == 24) {
        PU8 p8 = svga_fb + y * svga_pitch + x * 3;
        p8[0] = (U8)px;
        p8[1] = (U8)(px >> 8);
        p8[2] = (U8)(px >> 16);
    } else {
        PU32 p32 = (PU32)(svga_fb + y * svga_pitch + x * 4);
        p32[0] = px;
    }
}

U8 SVGA_INIT()
{
    svga_fb = (PU8)0;
    svga_width = 0;
    svga_height = 0;
    svga_pitch = 0;
    svga_bpp = 0;
    svga_cx = 0;
    svga_cy = 0;

    if (!bootstrap) return FALSE;
    if (bootstrap->boot_magic != BOOT_MAGIC) return FALSE;
    if (STRNICMP(bootstrap->vga_struct.abSignature, "VESA", 4)) return FALSE;

    svga_width  = (U32)bootstrap->vga_mode_info.wHorizRes;
    svga_height = (U32)bootstrap->vga_mode_info.wVertRes;
    svga_pitch  = (U32)bootstrap->vga_mode_info.wScanLineSiz;
    svga_bpp    = bootstrap->vga_mode_info.bBitsPerPel;
    svga_fb     = (PU8)bootstrap->vga_mode_info.physBasePtr;

    // Fallbacks for standard VGA mode 0x13 (320x200x256, framebuffer A0000).
    if (svga_width == 0 || svga_width > 4096)  svga_width = 320;
    if (svga_height == 0 || svga_height > 4096) svga_height = 200;
    if (svga_pitch == 0) svga_pitch = svga_width;
    if (svga_bpp == 0)   svga_bpp = 8;
    if (svga_fb == 0)    svga_fb = (PU8)0xA0000;

    asm {
        MOV EAX, svga_font8x8
        MOV svga_font, EAX
    }

    // Choose sensible black/white colors for the current bit depth.
    if (svga_bpp == 32) { svga_fg = 0xFFFFFFFF; svga_bg = 0x00000000; }
    else if (svga_bpp == 24) { svga_fg = 0xFFFFFF; svga_bg = 0x000000; }
    else if (svga_bpp == 16) { svga_fg = 0xFFFF; svga_bg = 0x0000; }
    else { svga_fg = 0x0F; svga_bg = 0x00; }
    SVGA_CLEAR((U8)svga_bg);

    return TRUE;
}

U0 SVGA_DRAW_PIXEL(U32 x, U32 y, U8 color)
{
    svga_set_px(x, y, (U32)color);
}

U0 SVGA_CLEAR(U8 color)
{
    if (!svga_fb) return;
    if (svga_bpp == 8) {
        U32 i;
        for (i = 0; i < svga_pitch * svga_height; i++) {
            svga_fb[i] = color;
        }
    } else {
        U32 x; U32 y;
        for (y = 0; y < svga_height; y++) {
            for (x = 0; x < svga_width; x++) {
                svga_set_px(x, y, (U32)color);
            }
        }
    }
    svga_cx = 0;
    svga_cy = 0;
}

// Scroll the framebuffer up by one text row (8 pixels).  Optimized for 8bpp.
U0 svga_scroll()
{
    U32 i;
    if (!svga_fb) return;
    if (svga_bpp != 8) {
        SVGA_CLEAR((U8)svga_bg);
        return;
    }
    for (i = svga_pitch * 8; i < svga_pitch * svga_height; i++) {
        svga_fb[i - svga_pitch * 8] = svga_fb[i];
    }
    for (i = svga_pitch * (svga_height - 8); i < svga_pitch * svga_height; i++) {
        svga_fb[i] = (U8)svga_bg;
    }
}

U0 SVGA_PUTCHAR(U8 c)
{
    U32 cols = svga_width / 8;
    U32 rows = svga_height / 8;
    U32 gi;
    PU8 glyph;
    U32 row;
    U32 col;

    if (!svga_fb) return;

    if (c == '\n') {
        svga_cx = 0;
        svga_cy++;
    } else if (c == '\r') {
        svga_cx = 0;
    } else if (c == '\b') {
        if (svga_cx > 0) svga_cx--;
    } else if (c == '\t') {
        svga_cx = (svga_cx + 4) & ~3;
    } else {
        if (c < 0x20 || c > 0x7E) gi = 0; else gi = (U32)c - 0x20;
        glyph = svga_font + gi * 8;
        for (row = 0; row < 8; row++) {
            U8 bits = glyph[row];
            for (col = 0; col < 8; col++) {
                U32 col_val = (bits & (0x80 >> col)) ? svga_fg : svga_bg;
                svga_set_px(svga_cx * 8 + col, svga_cy * 8 + row, col_val);
            }
        }
        svga_cx++;
    }

    if (svga_cx >= cols) {
        svga_cx = 0;
        svga_cy++;
    }
    if (svga_cy >= rows) {
        svga_scroll();
        svga_cy = rows - 1;
    }
}

U0 SVGA_PUTS(PU8 str)
{
    U32 i = 0;
    while (str[i] != 0) {
        SVGA_PUTCHAR(str[i]);
        i++;
    }
}
