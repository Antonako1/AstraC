    idt_set_gate(47, (U32)&irq47, 0x08, 0x8E);
}

U0 irq_handler(PU32 r)
{
    if (r[12] == 33)
    {
        KEYBOARD_HANDLER();
    }

    asm {
        MOV AL, 0x20
        DB 0xE6, 0x20
    }

    if (r[12] >= 40)
    {
        asm {
            MOV AL, 0x20
            DB 0xE6, 0xA0
        }
    }
}
