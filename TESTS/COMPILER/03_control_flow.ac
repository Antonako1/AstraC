/* Test 03: Control flow */

U32 test_if_else(U32 val) {
    if (val == 1) {
        return 10;
    } else if (val == 2) {
        return 20;
    } else {
        return 30;
    }
}

U32 test_while() {
    U32 sum = 0;
    U32 i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 5) {
            continue;
        }
        if (i == 9) {
            break;
        }
        sum = sum + i;
    }
    return sum;
}

U32 test_do_while() {
    U32 count = 0;
    U32 i = 0;
    do {
        i = i + 1;
        if (i % 2 == 0) {
            continue;
        }
        count = count + 1;
    } while (i < 10);
    return count;
}

U32 test_switch(U32 key) {
    U32 res = 0;
    switch (key) {
        case 1:
            res = 100;
            break;
        case 2:
            res = 200;
            break;
        case 3:
            res = 300;
            break;
        default:
            res = 999;
            break;
    }
    return res;
}

U32 test_goto() {
    U32 x = 0;
    goto my_label;
    x = 100;
my_label:
    x = x + 42;
    return x;
}

U32 main() {
    U32 r1 = test_if_else(2);
    U32 r2 = test_while();
    U32 r3 = test_do_while();
    U32 r4 = test_switch(2);
    U32 r5 = test_goto();
    return r1 + r2 + r3 + r4 + r5;
}
