// KERNEL/KERNEL.AC — 32-bit kernel
// _start() MUST be at org offset 0 — second stage jumps to 0x10000
#include "../KERNEL/KERNEL.AH"

U0 print_c(U8 c);
U0 print_s(PU8 str);
U0 clear_screen();

U0 _start(_BOOTSTRAP *bstrap) {
    // _CLI
    // _HLT
    bootstrap = bstrap;

    // Validate and initialise the SVGA/VBE framebuffer.  Halt if it failed.
    if (!SVGA_INIT()) {
        _HLT
    }

    asm { CLI }
    clear_screen();
    print_s("AstraOS 32-bit kernel loaded!\n");
    print_s("Initializing GDT...\n");
    GDT_INIT();
    print_s("Initializing IDT...\n");
    IDT_INIT();
    print_s("Initializing ISR...\n");
    ISR_INIT();
    print_s("Remapping PIC...\n");
    PIC_REMAP();
    print_s("Initializing IRQ...\n");
    IRQ_INIT();
    print_s("Initializing PS2 keyboard...\n");
    PS2_INIT();
    print_s("Kernel ready.\n");
    asm { STI }

    while (1) {
        if (PS2_KEY_READY()) {
            print_c(PS2_GETC());
        }
    }
}


// ── Console output ──────────────────────────────────────────────────────
// Delegates to the SVGA framebuffer text console.
U0 clear_screen() {
    return;
    SVGA_CLEAR(0x00);
}

U0 print_c(U8 c) {
    return;
    SVGA_PUTCHAR(c);
}

U0 print_s(PU8 str) {
    return;
    SVGA_PUTS(str);
}
