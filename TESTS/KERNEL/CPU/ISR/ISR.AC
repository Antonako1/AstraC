U0 isr_handler(PU32 r);

U0 isr_common_func()
{
    asm {
    isr_common_stub:
        PUSHAD
        PUSH DS
        PUSH ES
        PUSH FS
        PUSH GS
        MOV AX, 0x10
        MOV DS, AX
        MOV ES, AX
        MOV FS, AX
        MOV GS, AX
        MOV EAX, ESP
        PUSH EAX
        CALL _isr_handler
        ADD ESP, 4
        POP GS
        POP FS
        POP ES
        POP DS
        POPAD
        ADD ESP, 8
        IRET
    }
}

