// Bootloader that prints "HELLO WORLD" via BIOS INT 0x10
// Compile: AstraC.exe comp AS/BOOTLOADER.AC bits 16 org 7C00

U0 main() {
    asm {
        XOR AX, AX
        MOV DS, AX
        MOV ES, AX
        MOV SS, AX
        MOV SP, 0x7C00

        LEA SI, msg
        MOV AH, 0x0E

    .loop:
        LODSB
        OR AL, AL
        JZ .done
        INT 0x10
        JMP .loop

    .done:
        HLT
        JMP .done

    msg DB "HELLO WORLD", 0

    .times 510-($-$$) DB 0
    0xAA55
    }
}
