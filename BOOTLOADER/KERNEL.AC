// BOOTLOADER/KERNEL.AC — 32-bit kernel
// Writes "HELLO WORLD" to VGA text mode buffer at 0xB8000.
// Compile: AstraC.exe comp BOOTLOADER/KERNEL.AC bits 32 org 10000

#include "./KERNEL.AH"

U0 print_c(U8 c);
U0 print_s(PU8 str);
U0 clear_screen();



U0 main() {
    clear_screen();
    PU8 msg = (PU8)"Hello, World!";
    print_s(msg);
    while (1) {
        asm { HLT }
    }
}

U0 clear_screen() {
    PU8 vga_buffer = (PU8)0xB8000;
    U32 offset = 0;
    for (U32 i = 0; i < 80 * 25; i++) {
        vga_buffer[offset] = ' ';
        vga_buffer[offset + 1] = 0x07;
        offset += 2;
    }
}

U0 print_s(PU8 str) {
    PU8 vga_buffer = (PU8)0xB8000;
    U32 offset = 0;
    for(U32 i = 0; str[i] != 0; i = i + 1) {
        vga_buffer[offset] = str[i];
        vga_buffer[offset + 1] = 0x02;
        offset += 2;
    }
}

U0 print_c(U8 c) {
    PU8 vga_buffer = (PU8)0xB8000;
    vga_buffer[0] = c;
    vga_buffer[1] = 0x07;
}
